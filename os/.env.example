# ─── Supabase (required) ──────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Comma-separated list of emails allowed to sign up / sign in.
# JARVIS is a personal system: leave this set so strangers can't use your API credits.
JARVIS_ALLOWED_EMAILS=you@example.com

# ─── Claude (required) ────────────────────────────────────────────────
# console.anthropic.com → API Keys. Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional overrides
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (medium is a good everyday default)
JARVIS_EFFORT=medium
# Set to "true" to let Research mode search the web (Claude web search tool).
# Web search must also be enabled for your org in the Anthropic Console; it is billed per search.
JARVIS_WEB_SEARCH=false

# ─── ElevenLabs voice (optional; free tier works) ─────────────────────
# elevenlabs.io → Profile → API Keys. Server-side only.
ELEVENLABS_API_KEY=
# A voice id from your ElevenLabs Voice Library. Default is a premade voice.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 is the cheapest/fastest model, which stretches free-tier credits.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Max characters spoken per reply (protects free-tier credits). Longer replies are trimmed for voice only.
ELEVENLABS_MAX_CHARS=600

# ─── Rate limiting ────────────────────────────────────────────────────
# Requests per user per minute for AI endpoints (in-memory, per server instance).
JARVIS_RATE_LIMIT_PER_MIN=20
