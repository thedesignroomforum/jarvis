# ── AI (required for answers) ─────────────────────────────
# Claude API key from console.anthropic.com. Server-side only: NEVER prefix with VITE_.
AI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
# Effort: low is fastest for voice; raise for deeper text answers.
AI_EFFORT_VOICE=low
AI_EFFORT_TEXT=medium

# Free alternative: Google Gemini (no card). Get a key at https://aistudio.google.com/apikey
# If only GEMINI_API_KEY is set, JARVIS uses Gemini automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── ElevenLabs voice (optional; free plan works) ──────────
# Without it, JARVIS uses the best male voice built into your browser/OS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_MAX_CHARS=700

# ── Protection for a public deployment (recommended on Vercel) ──
# If set, the app asks for this code once and sends it with every request.
JARVIS_ACCESS_CODE=
JARVIS_RATE_LIMIT_PER_MIN=30
